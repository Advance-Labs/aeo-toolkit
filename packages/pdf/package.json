{
  "name": "@advance-labs/pdf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Server-side PDF audit report renderer for the AEO Toolkit, built on @react-pdf/renderer.",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@advance-labs/types": "workspace:*",
    "@react-pdf/renderer": "^4.1.6",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@advance-labs/config": "workspace:*",
    "@types/react": "^19.0.2",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  }
}
