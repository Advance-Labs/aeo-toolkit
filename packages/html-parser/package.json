{
  "name": "@advance-labs/html-parser",
  "version": "0.2.0",
  "type": "module",
  "description": "Pure HTML extraction for the AEO Toolkit — meta/OG/Twitter, headings, images, links, content signals, and raw structured-data blocks. No network.",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@advance-labs/types": "workspace:*",
    "cheerio": "^1.0.0"
  },
  "devDependencies": {
    "@advance-labs/config": "workspace:*",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Advance-Labs/aeo-toolkit.git",
    "directory": "packages/html-parser"
  },
  "homepage": "https://github.com/Advance-Labs/aeo-toolkit#readme"
}
