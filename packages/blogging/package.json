{
  "name": "@aeo/blogging",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Autonomous multi-agent blogging pipeline: research GSC query gaps, draft with Groq, edit, dedup via Jaccard fingerprints, schedule, publish, and self-correct underperformers. Built on @aeo/google-api and @aeo/llm (BYOK). All I/O is injected, so it is fully testable with no network.",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@aeo/google-api": "workspace:*",
    "@aeo/llm": "workspace:*",
    "@aeo/storage": "workspace:*",
    "@aeo/types": "workspace:*"
  },
  "devDependencies": {
    "@aeo/config": "workspace:*",
    "@types/node": "^22.10.2",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
