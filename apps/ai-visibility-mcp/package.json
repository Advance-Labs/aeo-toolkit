{
  "name": "@aeo/ai-visibility-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hosted MCP server for Claude that scores AEO signals and checks AI-visibility via Perplexity Sonar citations (BYOK).",
  "bin": {
    "ai-visibility-mcp": "./dist/server.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/server.js",
    "start:http": "node dist/http.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@aeo/crawler": "workspace:*",
    "@aeo/html-parser": "workspace:*",
    "@aeo/llm": "workspace:*",
    "@aeo/mcp-core": "workspace:*",
    "@aeo/schema-validator": "workspace:*",
    "@aeo/scoring": "workspace:*",
    "@aeo/types": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@aeo/config": "workspace:*",
    "@types/node": "^22.10.2",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
