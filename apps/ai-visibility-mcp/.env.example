# @aeo/ai-visibility-mcp — environment variables
#
# Copy to `.env` for local development. Every var is OPTIONAL: with none set the
# server runs fully (stdio + HTTP), using an in-memory per-caller rate limiter and
# placeholder OAuth discovery URLs. Production sets the Upstash + OAuth vars.
#
# BYOK note: there is NO Perplexity API key here. The Perplexity Sonar key is a
# per-request tool argument (bring-your-own-key) passed straight to @aeo/llm and
# never read from the environment, stored, or logged.

# --- Distributed rate limiting (Upstash Redis) -------------------------------
# When BOTH are set, the hosted HTTP entry uses an Upstash sliding-window limiter
# so each caller's budget holds across stateless serverless invocations. When
# absent, it falls back to an in-process fixed-window limiter (single instance).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Hosted-mode OAuth 2.1 discovery (.well-known) ---------------------------
# Public base URL of this server. Becomes the protected `resource` and the
# default issuer in the .well-known documents Claude.ai fetches.
MCP_PUBLIC_URL=

# OAuth authorization-server issuer URL (defaults to MCP_PUBLIC_URL when unset).
OAUTH_ISSUER=

# Comma-separated issuer URLs allowed to mint tokens (defaults to OAUTH_ISSUER).
OAUTH_AUTHORIZATION_SERVERS=

# --- Local HTTP server -------------------------------------------------------
# Port for `node dist/http.js` (the standalone Node HTTP transport). Default 8787.
PORT=
