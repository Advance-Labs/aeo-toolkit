# @aeo/blogging-agent environment.
#
# Copy to `.env` and fill in. Every variable below is read by the app at run time. BYOK keys and
# service credentials live only in memory for the duration of a run and are never persisted or
# logged (the structured run summary printed at the end contains no secrets). With no
# PUBLISH_WEBHOOK_URL the agent runs a dry run; with no SUPABASE_* it uses the JSON-file post store.

# --- LLM (BYOK, cost-split) --------------------------------------------------
# Bulk drafting model (cheap, high-throughput). Required.
GROQ_API_KEY=
# Strategic reasoning model. At least one of the two is required; Anthropic is preferred when both set.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional model-id overrides.
GROQ_MODEL=llama-3.3-70b-versatile
ANTHROPIC_MODEL=claude-sonnet-4-20250514
OPENAI_MODEL=gpt-4o

# --- Google (GSC + GA4 reads) ------------------------------------------------
# Read-only OAuth access token for Search Console + GA4. Required.
GOOGLE_ACCESS_TOKEN=
# Numeric GA4 property id. Required.
GA4_PROPERTY_ID=
# Canonical site origin (e.g. https://example.com). Required.
SITE_URL=
# Search Console property URL. Optional; defaults to SITE_URL.
GSC_SITE_URL=

# --- Persistence -------------------------------------------------------------
# Supabase-backed durable post store. Set BOTH to enable; otherwise the JSON-file store is used.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional posts table name override (default: posts).
POSTS_TABLE=posts
# JSON-file store location (fallback when Supabase is not configured).
POST_STORE_PATH=./data/posts.json

# --- Publishing (the only side effect) ---------------------------------------
# Webhook that receives each rendered post (JSON: slug, title, markdown, primaryKeyword, canonical).
# Omit to run in dry-run mode (NoopPublisher).
PUBLISH_WEBHOOK_URL=
# Optional request-scoped bearer token sent in the Authorization header of the publish request.
PUBLISH_WEBHOOK_TOKEN=
# Optional deploy hook pinged with an empty POST after a successful publish (e.g. a Vercel hook).
DEPLOY_HOOK_URL=

# --- Pipeline tuning (optional) ----------------------------------------------
MAX_NEW_POSTS_PER_RUN=3
UNDERPERFORMANCE_THRESHOLD=0.3
DEDUP_THRESHOLD=0.8

# --- Strategy seed (optional) ------------------------------------------------
# Comma-separated lists / free text used to steer the strategy + writer.
CONTENT_PILLARS=
COMPETITORS=
AUDIENCE=a general professional readership
VOICE=clear, authoritative, and practical
