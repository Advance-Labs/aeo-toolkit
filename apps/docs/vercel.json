{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm exec turbo run build --filter=@advance-labs/docs",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/aeo-toolkit", "destination": "/" },
    { "source": "/aeo-toolkit/:path*", "destination": "/:path*" }
  ]
}
