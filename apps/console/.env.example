# ── AEO Toolkit Console — unified environment ──────────────────────────────
# One Vercel project hosts every tool, the MCP endpoints, and the blogging cron.
# BYOK keys (the user's LLM / Perplexity keys for chat & AI-visibility) are passed
# per-request and are NEVER read from here.

# Public base URL of this deployment (used by MCP .well-known discovery).
MCP_PUBLIC_URL=https://toolkit.example.com

# ── Site Audit (/tools/audit) ──
AUDIT_MAX_PAGES=50

# ── Backlink Graph (/tools/graph) ──
BACKLINK_GRAPH_LIMIT=25
# BACKLINK_CC_INDEX=CC-MAIN-2024-51-index

# ── Distributed rate limiting (audit + MCP). Falls back to in-memory when unset. ──
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── Google OAuth (GA4 + Search Console: /tools/chat and the ga-gsc MCP) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://toolkit.example.com/api/auth/google/callback

# ── Durable, encrypted storage (Supabase) for OAuth tokens + blog posts ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TOKEN_ENCRYPTION_KEY=
POSTS_TABLE=posts

# ── MCP hosted OAuth ──
OAUTH_STATE_SECRET=
# OAUTH_ISSUER=
# OAUTH_AUTHORIZATION_SERVERS=

# ── Blogging agent (Vercel Cron → /api/cron/blogging) ──
CRON_SECRET=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
GOOGLE_ACCESS_TOKEN=
GA4_PROPERTY_ID=
SITE_URL=
GSC_SITE_URL=
# PUBLISH_WEBHOOK_URL=
# PUBLISH_WEBHOOK_TOKEN=
# DEPLOY_HOOK_URL=
