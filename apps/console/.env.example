# ── AEO Toolkit Console — unified environment ──────────────────────────────
# One Vercel project hosts every tool, the MCP endpoints, and the blogging cron.
# BYOK keys (the user's LLM / Perplexity keys for chat & AI-visibility) are passed
# per-request and are NEVER read from here.

# Public base URL of this deployment (used by MCP .well-known discovery).
MCP_PUBLIC_URL=https://toolkit.example.com

# ── Site Audit (/tools/audit) ──
AUDIT_MAX_PAGES=50

# ── Backlink Graph (/tools/graph) ──
BACKLINK_GRAPH_LIMIT=25
# BACKLINK_CC_INDEX=CC-MAIN-2024-51-index

# ── Distributed rate limiting (audit + MCP). Falls back to in-memory when unset. ──
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── Google OAuth (GA4 + Search Console: /tools/chat and the ga-gsc MCP) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://toolkit.example.com/api/auth/google/callback

# ── Durable, encrypted storage (Supabase) for OAuth tokens + blog posts ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TOKEN_ENCRYPTION_KEY=
POSTS_TABLE=posts

# ── MCP hosted OAuth ──
OAUTH_STATE_SECRET=
# OAUTH_ISSUER=
# OAUTH_AUTHORIZATION_SERVERS=

# ── Blogging agent (Vercel Cron → /api/cron/blogging) ──
CRON_SECRET=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
GOOGLE_ACCESS_TOKEN=
GA4_PROPERTY_ID=
SITE_URL=
GSC_SITE_URL=
# PUBLISH_WEBHOOK_URL=
# PUBLISH_WEBHOOK_TOKEN=
# DEPLOY_HOOK_URL=

# ════════════════════════════════════════════════════════════════════════════
# Commercial layer (auth + billing + gating) — OPTIONAL / DORMANT
# ────────────────────────────────────────────────────────────────────────────
# The site runs FULLY without any of the vars below: all five tools stay free
# and open, no sign-in, no paywall — exactly as today. Auth and billing light up
# only when their keys are present (the "lights up when creds are added"
# convention, e.g. ga-gsc). Full activation steps: docs/ACTIVATION.md.
# ════════════════════════════════════════════════════════════════════════════

# ── Supabase Auth (magic-link). Sets AUTH_ENABLED when BOTH are present. ──
# The anon/PUBLISHABLE key (NOT the service-role key above) — safe in the browser; RLS enforces access.
# NEXT_PUBLIC_SUPABASE_URL is the same project URL as SUPABASE_URL (the Vercel Supabase integration
# sets it in production); add it here too when running auth locally.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Stripe billing. Setting STRIPE_SECRET_KEY flips BILLING_ENABLED on. ──
# STRIPE_SECRET_KEY=                     # sk_test_… / sk_live_… (server-only; never logged)
# STRIPE_WEBHOOK_SECRET=                 # whsec_… — verifies POST /api/billing/webhook signatures
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=    # pk_test_… / pk_live_… (browser; pricing UI only)
# STRIPE_PRICE_PRO=                      # price_… for the Pro plan (mapped in lib/billing/plans.ts)
# STRIPE_PRICE_AGENCY=                   # price_… for the Agency plan

# ════════════════════════════════════════════════════════════════════════════
# Managed / Autopilot tier — OPTIONAL / DORMANT (done-for-you service)
# ────────────────────────────────────────────────────────────────────────────
# Inert until configured. Presence of STRIPE_PRICE_MANAGED *or* ORCHESTRATOR_JOB_SECRET
# flips MANAGED_ENABLED on. Setup runbook: docs/AUTOPILOT-GO-LIVE.md.
# ════════════════════════════════════════════════════════════════════════════
# STRIPE_PRICE_MANAGED=                  # price_… for the Managed plan ($499/mo per site)
# ORCHESTRATOR_JOB_SECRET=               # constant-time auth for POST /api/orchestrator/run (H1)
# STAFF_EMAILS=                          # comma-separated allowlist for the staff approval inbox (C2)
# Platform LLM for the done-for-you service (Advance-Labs-provided, NOT customer BYOK):
# MANAGED_LLM_PROVIDER=                  # e.g. anthropic
# MANAGED_LLM_API_KEY=                   # the platform LLM key (server-only; never logged)
# MANAGED_DRAFT_MODEL=                   # e.g. claude-haiku-4-5-20251001
# MANAGED_REASONING_MODEL=               # e.g. claude-sonnet-4-6
# (TOKEN_ENCRYPTION_KEY above is REQUIRED for managed — the token store refuses plaintext.)
# (PUBLISH_WEBHOOK_URL above wires the real CMS publish; omit for safe dry-run.)
