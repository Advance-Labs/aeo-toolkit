{
  "name": "@aeo/backlink-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Free-source backlink MCP server: brand mentions, prospects, contacts, link verification, and AI-assisted outreach.",
  "bin": {
    "backlink-mcp": "./dist/server.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/server.js",
    "start:http": "node dist/http.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@aeo/crawler": "workspace:*",
    "@aeo/llm": "workspace:*",
    "@aeo/mcp-core": "workspace:*",
    "@aeo/types": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "cheerio": "^1.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@aeo/config": "workspace:*",
    "@types/node": "^22.10.2",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
