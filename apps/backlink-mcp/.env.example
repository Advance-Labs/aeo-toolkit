# @aeo/backlink-mcp — environment variables
#
# Every var here is OPTIONAL: the server runs with polite defaults and NO
# credentials. Distributed rate limiting (Upstash) is opt-in; everything else
# tunes politeness/identity. Secrets come ONLY from the environment — never
# hard-code or commit real values. Copy to `.env` for local overrides.

# --- Per-tool-call rate limit (token bucket, @aeo/mcp-core) ---------------------
# Max burst of tool calls and how fast the bucket refills.
BACKLINK_RATE_CAPACITY=8
BACKLINK_RATE_REFILL_PER_SEC=1

# --- Outbound scrape rate limit (@aeo/storage resolveRateLimiter) ---------------
# Caps the raw outbound request rate to the free sources (DuckDuckGo, Wayback,
# CommonCrawl) across a single tool call's fan-out. Configurable.
BACKLINK_SCRAPE_LIMIT=30
BACKLINK_SCRAPE_WINDOW_SECONDS=60

# --- Distributed rate limiting (Upstash Redis) ----------------------------------
# Set BOTH to enable a shared, multi-instance sliding-window limiter (serverless /
# Vercel). Leave unset for the single-instance in-memory fallback (local/dev/tests).
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-rest-token

# --- CommonCrawl supplementary source -------------------------------------------
# Monthly crawl index id queried for extra mentions/pages. Roll forward as new
# crawls publish (https://index.commoncrawl.org/collinfo.json).
BACKLINK_CC_INDEX=CC-MAIN-2024-51

# --- HTTP client identity / timeout ---------------------------------------------
# Honest User-Agent and per-request network timeout for outbound fetches.
# BACKLINK_USER_AGENT=aeo-backlink-mcp/0.1 (+https://github.com/aeo-toolkit; polite free-source link research)
BACKLINK_REQUEST_TIMEOUT_MS=15000

# --- Remote (HTTP / Vercel) entry: src/http.ts + api/* --------------------------
# Listen port (self-hosted http.js only).
PORT=3000
# Public origin advertised in OAuth 2.1 .well-known discovery docs.
# MCP_PUBLIC_URL is canonical across the suite; BACKLINK_PUBLIC_URL is a legacy alias.
# MCP_PUBLIC_URL=https://backlink-mcp.example.com
# BACKLINK_PUBLIC_URL=https://backlink-mcp.example.com
# External OAuth issuer for protected-resource metadata (defaults to the public origin).
# BACKLINK_AUTH_SERVER=https://auth.example.com
# Set to 1 to import http.ts WITHOUT auto-starting a listener (serverless adapters).
# BACKLINK_HTTP_NO_LISTEN=1

# --- BYOK (generate_outreach_email) ---------------------------------------------
# The LLM API key is supplied PER REQUEST in the tool input (request-scoped) and is
# forwarded to @aeo/llm — never persisted or logged by this server. No env var.
