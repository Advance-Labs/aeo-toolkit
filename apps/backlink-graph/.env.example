# Backlink Graph — environment

# Max pages pulled from each free source per build (kept polite). Default 25.
BACKLINK_GRAPH_LIMIT=25

# Optional: override the CommonCrawl monthly index (default tracks a recent crawl).
# COMMONCRAWL_INDEX=CC-MAIN-2024-51-index

# Optional distributed rate limiting for the public endpoint (falls back to in-memory).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
