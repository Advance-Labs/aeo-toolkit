# @aeo/llm-audit environment
#
# The core audit (crawl → parse → detect → score → report → PDF) is fully self-hosted and needs NO
# credentials. The variables below are all OPTIONAL: with none set, the app runs locally with an
# in-memory, single-instance rate limiter. Set the Upstash pair in production for a durable,
# multi-instance-safe per-IP limiter. Secrets must come from the environment — never commit real
# values.

# Default page cap when the request omits `maxPages`. Clamped to a hard ceiling of 100.
AUDIT_MAX_PAGES=50

# Distributed per-IP rate limiting (Upstash Redis REST). Provide BOTH to enable the production
# limiter; omit (or set only one) to fall back to the in-memory limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
