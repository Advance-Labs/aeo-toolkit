{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/mcp", "destination": "/api/index" },
    { "source": "/authorize", "destination": "/api/index" },
    { "source": "/oauth/callback", "destination": "/api/index" },
    { "source": "/health", "destination": "/api/index" },
    { "source": "/.well-known/oauth-authorization-server", "destination": "/api/index" },
    { "source": "/.well-known/oauth-protected-resource", "destination": "/api/index" }
  ]
}
