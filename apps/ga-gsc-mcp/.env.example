# Google OAuth client (required for the hosted connect flow).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match ${MCP_PUBLIC_URL}/oauth/callback
GOOGLE_REDIRECT_URI=http://localhost:8787/oauth/callback

# Public base URL of this MCP server (used in .well-known discovery docs).
MCP_PUBLIC_URL=http://localhost:8787

# Local single-user dev: a pre-issued read-only Google access token so tools run
# without an OAuth round-trip. Leave empty in production.
GOOGLE_ACCESS_TOKEN=

# Optional HTTP listen port (default 8787).
PORT=8787

# Optional token-bucket rate limit (defaults: 30 / 5).
MCP_RATE_CAPACITY=30
MCP_RATE_REFILL_PER_SEC=5
