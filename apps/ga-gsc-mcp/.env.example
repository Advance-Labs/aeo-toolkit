# Google OAuth client (required for the hosted connect flow).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match ${MCP_PUBLIC_URL}/oauth/callback
GOOGLE_REDIRECT_URI=http://localhost:8787/oauth/callback

# Public base URL of this MCP server (used in .well-known discovery docs).
MCP_PUBLIC_URL=http://localhost:8787

# HMAC-SHA256 secret used to sign the OAuth `state` parameter so a forged callback
# cannot write tokens under another user's identity. Required for the hosted connect
# flow (the /authorize endpoint returns 501 without it). Use a long random value.
OAUTH_STATE_SECRET=

# Durable, multi-instance OAuth token store (Supabase). When BOTH are set, the server
# persists tokens in Supabase instead of the in-memory fallback (which does not survive
# stateless serverless invocations). Leave empty for local single-instance dev.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional passphrase to encrypt OAuth access/refresh tokens at rest (AES-256-GCM) in
# the Supabase store. Strongly recommended in production. Omit to store tokens verbatim.
TOKEN_ENCRYPTION_KEY=

# Local single-user dev: a pre-issued read-only Google access token so tools run
# without an OAuth round-trip. Leave empty in production.
GOOGLE_ACCESS_TOKEN=

# Optional HTTP listen port (default 8787).
PORT=8787

# Optional token-bucket rate limit (defaults: 30 / 5).
MCP_RATE_CAPACITY=30
MCP_RATE_REFILL_PER_SEC=5
