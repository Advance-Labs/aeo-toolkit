# Google OAuth 2.0 credentials (server-side only).
# Create an OAuth client (type: Web application) in the Google Cloud Console and enable the
# "Google Analytics Data API" and "Search Console API". Add GOOGLE_REDIRECT_URI as an authorized
# redirect URI. The app requests read-only scopes (analytics.readonly, webmasters.readonly).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Durable, encrypted OAuth token storage (production). When SUPABASE_URL and
# SUPABASE_SERVICE_ROLE_KEY are BOTH set, refresh tokens persist in the Supabase `oauth_tokens`
# table via @aeo/storage (multi-instance / serverless safe). Leave them unset for local dev to use
# the in-process in-memory store. The service-role key is server-only — never expose it to clients.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Passphrase for AES-256-GCM encryption of OAuth access/refresh tokens at rest. Strongly recommended
# whenever Supabase is configured; without it the Supabase store would persist plaintext tokens.
TOKEN_ENCRYPTION_KEY=a-long-random-secret

# NOTE: The user's LLM API key (Anthropic/OpenAI/Groq/Perplexity/Gateway) is NOT configured here.
# It is supplied per-request from the browser (BYOK) and is never persisted or logged server-side.
